<?xml version="1.0" encoding="utf-8"?>
<!-- Poster tile for KefinTweaks grids and rows: image, title and a subtitle line -->
<component name="KefinPosterItem" extends="Group">
  <children>
    <Rectangle id="background" width="230" height="340" color="#1F1F1F" />
    <Label id="placeholder" width="210" height="320" translation="[10, 10]" wrap="true" horizAlign="center" vertAlign="center" font="font:SmallSystemFont" color="#BBBBBB" />
    <Poster id="poster" width="230" height="340" loadDisplayMode="scaleToZoom" />
    <Label id="title" width="230" height="36" translation="[0, 348]" font="font:SmallBoldSystemFont" horizAlign="left" />
    <Label id="subtitle" width="230" height="32" translation="[0, 384]" font="font:SmallestSystemFont" color="#AAAAAA" horizAlign="left" />
  </children>
  <interface>
    <field id="itemContent" type="node" onChange="itemContentChanged" />
    <field id="width" type="float" />
    <field id="height" type="float" />
  </interface>
</component>
